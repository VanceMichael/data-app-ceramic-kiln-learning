        "id": {
          "type": "string",
          "description": "窑次"
        },
        "planned": {
          "type": "string",
          "description": "原工艺"
        },
        "actual": {
          "type": "string",
          "description": "实际工艺"
        },
        "density": {
          "type": "number",
          "description": "装载密度"
        },
        "energy_kwh": {
          "type": "number",
          "description": "实耗电量"
        },
        "material": {
          "type": "string",
          "description": "材料批"
        },
        "day": {
          "type": "integer",
          "description": "烧制日"
        }
      },
      "refs": {}
    },
    "pieces": {
      "description": "坯体实物可以返工；留样不可销售",
