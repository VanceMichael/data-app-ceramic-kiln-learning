        "id": {
          "type": "string",
          "description": "实物"
        },
        "kiln": {
          "type": "string",
          "description": "当前窑次"
        },
        "shape": {
          "type": "string",
          "description": "器型"
        },
        "maker": {
          "type": "string",
          "description": "制作人"
        },
        "position": {
          "type": "string",
          "description": "窑位"
        },
        "formed_day": {
          "type": "integer",
