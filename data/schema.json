        "process": {
          "type": "string",
          "description": "工艺"
        },
        "shapes": {
          "type": "array",
          "description": "器型"
        },
        "materials": {
          "type": "array",
          "description": "材料"
        },
        "max_density": {
          "type": "number",
          "description": "最高密度"
        },
        "effective_day": {
          "type": "integer",
          "description": "起效日"
        },
        "state": {
          "type": "string",
          "description": "状态"
        }
      },
      "refs": {}
    },
